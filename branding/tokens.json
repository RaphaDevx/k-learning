{
  "version": "3.0",
  "name": "K-Learning Brand",
  "description": "Single source of truth for all design decisions. Edit here → propagate to brand.css, brand.js.",

  "font": {
    "family": "Nunito",
    "fallback": "-apple-system, system-ui, sans-serif",
    "weights": [400, 600, 700, 800],
    "googleUrl": "https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap",
    "localPath": "branding/fonts/",
    "note": "Self-hosted .woff2 go into branding/fonts/ — see fonts/README.md"
  },

  "typescale": {
    "display": { "size": "2rem",     "weight": 800, "lineHeight": "1.15", "tracking": "-0.02em" },
    "h1":      { "size": "1.5rem",   "weight": 700, "lineHeight": "1.2",  "tracking": "-0.01em" },
    "h2":      { "size": "1.25rem",  "weight": 700, "lineHeight": "1.3",  "tracking": "-0.005em" },
    "h3":      { "size": "1.05rem",  "weight": 600, "lineHeight": "1.4",  "tracking": "0" },
    "body":    { "size": "0.9375rem","weight": 400, "lineHeight": "1.6",  "tracking": "0" },
    "small":   { "size": "0.8125rem","weight": 400, "lineHeight": "1.5",  "tracking": "0" },
    "caption": { "size": "0.6875rem","weight": 600, "lineHeight": "1.4",  "tracking": "0.04em" },
    "label":   { "size": "0.75rem",  "weight": 600, "lineHeight": "1",    "tracking": "0.06em", "transform": "uppercase" }
  },

  "colors": {
    "accent":        "#6C47FF",
    "accentLight":   "rgba(108,71,255,0.15)",
    "accentBorder":  "rgba(108,71,255,0.35)",
    "accentSoft":    "#C4B5FD",
    "accentGlow":    "rgba(108,71,255,0.45)",
    "accentGrad":    "linear-gradient(90deg,#6C47FF,#A855F7)",
    "accentGrad135": "linear-gradient(135deg,#6C47FF,#A855F7)",

    "success":       "#3DD68C",
    "successLight":  "rgba(61,214,140,0.15)",
    "warning":       "#FFB347",
    "warningLight":  "rgba(255,179,71,0.15)",
    "danger":        "#FF6B6B",
    "dangerLight":   "rgba(255,107,107,0.15)",
    "info":          "#60A5FA",
    "infoLight":     "rgba(96,165,250,0.15)",

    "dark": {
      "bg":          "#0D0D16",
      "card":        "#19172A",
      "cardRaised":  "#231F3A",
      "sidebar":     "#110F1C",
      "overlay":     "rgba(13,13,22,0.85)",
      "txt":         "#F0EEFF",
      "txt2":        "rgba(240,238,255,0.55)",
      "txt3":        "rgba(240,238,255,0.28)",
      "border":      "rgba(255,255,255,0.09)",
      "borderHover": "rgba(255,255,255,0.18)"
    },

    "light": {
      "bg":          "#F5F3FF",
      "card":        "#FFFFFF",
      "cardRaised":  "#EDE8FF",
      "sidebar":     "#EDE9FF",
      "overlay":     "rgba(245,243,255,0.85)",
      "txt":         "#1A1640",
      "txt2":        "#6B6690",
      "txt3":        "#B0ACCC",
      "border":      "rgba(108,71,255,0.09)",
      "borderHover": "rgba(108,71,255,0.20)",
      "accent":      "#5B3EE8",
      "accentLight": "rgba(91,62,232,0.12)",
      "accentBorder":"rgba(91,62,232,0.30)"
    }
  },

  "radius": {
    "xs":   "6px",
    "sm":   "10px",
    "md":   "16px",
    "lg":   "22px",
    "xl":   "28px",
    "2xl":  "36px",
    "pill": "999px"
  },

  "spacing": {
    "1":  "4px",
    "2":  "8px",
    "3":  "12px",
    "4":  "16px",
    "5":  "20px",
    "6":  "24px",
    "8":  "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },

  "shadows": {
    "sm":     "0 1px 3px rgba(0,0,0,0.25), 0 1px 2px rgba(0,0,0,0.15)",
    "md":     "0 4px 16px rgba(0,0,0,0.35)",
    "lg":     "0 8px 32px rgba(0,0,0,0.45)",
    "accent": "0 4px 24px rgba(108,71,255,0.35)",
    "card":   "0 2px 12px rgba(0,0,0,0.3), 0 0 0 1px rgba(255,255,255,0.06)"
  },

  "animation": {
    "fast":    "150ms",
    "normal":  "250ms",
    "slow":    "400ms",
    "easeOut": "cubic-bezier(0.25,0.46,0.45,0.94)",
    "spring":  "cubic-bezier(0.34,1.56,0.64,1)"
  },

  "zIndex": {
    "base":    0,
    "raised":  10,
    "overlay": 40,
    "modal":   50,
    "toast":   60
  }
}
